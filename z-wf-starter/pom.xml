<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-wf</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>io.github.yuku123</groupId>

    <artifactId>z-wf-starter</artifactId>
    <name>z-wf-starter</name>
    <description>工作流引擎 Spring Boot Starter — 自动装配 Camunda 引擎 + 审批中心 REST + 可选 z-config/z-rpc 集成 (可运行应用见 z-wf-admin)</description>
    <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf/z-wf-starter</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>zifang</name>
            <email>yuku123@users.noreply.github.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/yuku123/z-opc-foundation.git</connection>
        <developerConnection>scm:git:ssh://github.com/yuku123/z-opc-foundation.git</developerConnection>
        <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-web</artifactId>
        </dependency>

        <!-- ========== 可选集成 (业务方 classpath 不含就不加载) ========== -->
        <!-- z-config 服务注册中心 (让 z-wf 自动注册到 z-config, 让其他服务发现 z-wf 实例) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-config-spring-boot-starter</artifactId>
            <version>1.0.1</version>
            <optional>true</optional>
        </dependency>

        <!-- z-rpc RPC 框架 (让 z-wf 暴露 @ZRpcService 接口, 让其他服务 @ZRpcReference 调用) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-rpc-spring-boot-starter</artifactId>
            <version>1.0.2</version>
            <optional>true</optional>
        </dependency>

        <!-- log4j2 API (WfServerLifecycle / audit SPI 直接使用 LogManager) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
