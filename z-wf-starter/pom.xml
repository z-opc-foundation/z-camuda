<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-wf</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>io.github.yuku123</groupId>

    <artifactId>z-wf-starter</artifactId>
    <name>z-wf-starter</name>
    <description>工作流引擎 Spring Boot Starter — 自动装配 Camunda 引擎 + 审批中心 REST + 可选 z-config/z-rpc 集成 (可运行应用见 z-wf-admin)</description>
    <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf/z-wf-starter</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>zifang</name>
            <email>yuku123@users.noreply.github.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/yuku123/z-opc-foundation.git</connection>
        <developerConnection>scm:git:ssh://github.com/yuku123/z-opc-foundation.git</developerConnection>
        <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-web</artifactId>
        </dependency>

        <!-- ========== 可选集成 (业务方 classpath 不含就不加载) ========== -->
        <!-- ⚠ 这两条原本写的是**字面** <version>1.0.1</version> / <version>1.0.2</version>，已删除。
             字面 <version> 优先级高于任何 dependencyManagement ⇒ fleet 那两格顶不住它，本仓一直停在
             自家 2024 年的旧构建上（central_chain_probe 的 literals-all 在本仓量的就是这 4 处，另两处在同一坐标的 admin 侧）。
             删掉之后由 z-boot-fleet 供：z-config-spring-boot-starter 1.0.1 → **1.0.8**、
             z-rpc-spring-boot-starter 1.0.2 → **1.0.3**（连带 z-config-client/common、z-rpc-api/core/remoting…
             整族一起抬）。这是**刻意换实现**的行为变化，不是顺手清理：本仓代码真的吃这两族的 API
             （WfServerLifecycle 用 com.zifang.z.config.client.naming.ZNamingService +
             com.zifang.z.rpc.starter.properties.ZRpcProperties，WfProcessRpcServiceImpl 用 @ZRpcService），
             所以抬号之后必须实测"编译过 + 测试红绿与迁移前一致"才算数。 -->
        <!-- z-config 服务注册中心 (让 z-wf 自动注册到 z-config, 让其他服务发现 z-wf 实例) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-config-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- z-rpc RPC 框架 (让 z-wf 暴露 @ZRpcService 接口, 让其他服务 @ZRpcReference 调用) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-rpc-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- log4j2 API (WfServerLifecycle / audit SPI 直接使用 LogManager) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- host 桥接类 (CamundaConfig: camundaBpmDataSource / camundaBpmTransactionManager) 编译期需要 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @ConditionalOnProperty 注解的宿主端自动装配 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- maven-compiler-plugin 这条"只为继承配置"的声明删掉，口径由父链 pluginManagement 下发
         （同 z-wf-core / z-wf-web 的注释；留一条无 version 的插件声明就是 central_pom_scan 的 E 类缺陷）。 -->
</project>
