<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-wf</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>io.github.yuku123</groupId>

    <artifactId>z-wf-web</artifactId>
    <name>z-wf-web</name>
    <description>工作流引擎 Web 模块 — REST API + 审批中心</description>
    <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf/z-wf-web</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>zifang</name>
            <email>yuku123@users.noreply.github.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/yuku123/z-opc-foundation.git</connection>
        <developerConnection>scm:git:ssh://github.com/yuku123/z-opc-foundation.git</developerConnection>
        <url>https://github.com/yuku123/z-opc-foundation/tree/main/z-wf</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-core</artifactId>
        </dependency>

        <!-- Spring Boot Web（排除默认 logging — 由 starter 层引入 log4j2 替换） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Swagger API 文档注解 (版本由 parent dependencyManagement 锁定) -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- z-util-core (Result 工具类) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <version>1.0.13</version>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
