    </dependency>
    <dependency>
      <groupId>io.github.yuku123</groupId>
      <artifactId>z-util-core</artifactId>
      <version>1.0.10</version>
      <scope>compile</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.26</version>
      <scope>compile</scope>
      <optional>true</optional>
