<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-wf-admin: 独立可启动应用 (docker 镜像源 / 本地 java -jar 演示), 永不上 Maven Central.
        对齐 z-schedule-admin 模式: own-parent (spring-boot-starter-parent) + maven.deploy.skip=true.
        <version> 与依赖的 z-wf-starter 版本必须与 ../pom.xml 的 <revision> 保持一致.
        本地启动: mvn spring-boot:run  (端口/context-path 见 application.properties)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.12</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-wf-admin</artifactId>
    <version>1.0.5</version>
    <packaging>jar</packaging>
    <name>z-wf :: admin (Standalone App, NOT published to Central)</name>
    <description>Z-WF 独立可启动应用 — Camunda 引擎 + 审批中心 REST + 自带管理前端. 不发 Maven Central.</description>

    <properties>
        <!-- 与 ../pom.xml <revision> 同步 -->
        <z-wf.version>1.0.5</z-wf.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 兄弟仓 z-* 的版本权威：直接 import z-boot-fleet（z-boot-parent 供的就是这一份，
                 由 gen_fleet_bom.py 逐件核过 repo1 才落笔）。
                 ⚠ 本模块**不在** z-boot-parent 那条链上：它的 <parent> 是 spring-boot-starter-parent，
                 这是 z-wf-admin 建仓就有的既有形状（"独立可启动应用 + maven.deploy.skip + 永不上 Central"，
                 根 pom 的 <module> 注释与 excludeArtifacts 都写着）。把它改挂到 z-wf/z-boot-parent 上
                 会顺手把整个可运行应用的第三方口径从 Boot 2.7.12 抬到地板 2.7.18、jackson 2.13.5 抬到 2.18.6、
                 并让地板那条 spring-boot-starter-logging `*:*` exclusion 生效（logback 从 admin 树里消失）
                 —— 那是换一次运行时栈，不是一次迁 pom，所以这里**只**把"兄弟仓版本表"接到组织权威上，
                 第三方一格不动。要真收编 admin 的第三方口径，这是 CEO 的决定，见报告。
                 import 只会填空：本模块自己/父链已按坐标管着的（spring-boot 那一整族）都顶不动它，
                 而 starter-parent 压根不管 io.github.yuku123 任何一件 ⇒ 结果就是"内部件走 fleet、第三方走原样"。
                 原本这里躺着 6 条 ${z-util.version} 的 z-util 直接条目（bfc1c1b 为消除 1.0.2/1.0.10 与
                 1.0.13 混载补的）：fleet 按坐标供的同为 1.0.13 ⇒ 六条一起删、键一起删。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- z-wf 全栈: core (Camunda 引擎) + web (REST) + starter (自动装配 + z-config/z-rpc 可选集成) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-wf-starter</artifactId>
            <version>${z-wf.version}</version>
        </dependency>

        <!-- z-config 服务注册 + z-rpc RPC 暴露 (starter 里是 optional 不传递,
             独立部署形态必须在此显式声明, 否则 WfServerLifecycle 的服务注册失效).
             两条**字面** <version>1.0.1/1.0.2</version> 已删, 版本由上面 import 的 z-boot-fleet 供：
             z-config-spring-boot-starter 1.0.1 → 1.0.8、z-rpc-spring-boot-starter 1.0.2 → 1.0.3
             （与本仓 z-wf-starter 同一格，两处的账见 z-wf-starter/pom.xml 的注释）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-config-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-rpc-spring-boot-starter</artifactId>
        </dependency>

        <!-- MySQL (流程引擎持久化, 旧坐标 boot BOM 不管理, 与 z-wf parent 锁同版) -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- Druid 连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <version>1.2.18</version>
        </dependency>

        <!-- H2 内存数据库 (h2-test profile: 端到端测试 / 无外部依赖演示) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Knife4j API 文档 (doc.html) -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
            <version>4.1.0</version>
        </dependency>

        <!-- 日志: log4j2 替换默认 logback -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- 端到端测试 (JUnit 5 + Spring Boot Test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 fat jar 打包 (classifier=exec: 主 artifact 保持 thin jar, 对齐 z-schedule-admin).
                 execution id 必须写成 repackage 以覆盖 spring-boot-starter-parent 自带的同名 execution,
                 否则会触发两次 repackage (主 jar 被替换成 fat + exec jar 再 attach 一次) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>exec</classifier>
                            <mainClass>com.zifang.z.wf.admin.ZWfAdminApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
